{
  "schemaVersion": 1,
  "scenario": {
    "name": "Runtime State Seed"
  },
  "messages": [
    { "key": "spell-change", "text": "Your spell points shift." }
  ],
  "extraActionPoints": [
    {
      "key": "time-success",
      "id": 0,
      "steps": [{ "kind": "raw", "rawCode": 1, "id": 1 }]
    },
    {
      "key": "time-failure",
      "id": 1,
      "steps": [{ "kind": "raw", "rawCode": 1, "id": 2 }]
    }
  ],
  "actionPoints": [
    {
      "key": "runtime-state",
      "x": 10,
      "y": 10,
      "steps": [
        { "kind": "setDarkLevel", "dark": true, "stopIfUnchanged": true },
        { "kind": "alterGameTime", "mode": "offset", "days": 1, "hours": -2, "minutes": 15 },
        { "kind": "boatCampStatus", "continueBoat": "inBoat", "continueCamping": "notCamping", "setBoat": "inBoat" },
        { "kind": "alterFatigue", "mode": "percent", "percent": 60 },
        { "kind": "changeSpellPoints", "rolls": 2, "low": 1, "high": 6, "take": true, "message": "spell-change" },
        { "kind": "branchOnSpellPoints", "scope": "alive", "minimum": 5, "onFailure": "exitSave", "successMacro": "time-success" },
        { "kind": "branchOnGameTime", "dayAtMost": 10, "hourAtMost": 12, "successMacro": "time-success", "failureMacro": "time-failure" }
      ]
    }
  ]
}
