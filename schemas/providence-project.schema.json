{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isynic.github.io/realmz-providence/schemas/providence-project.schema.json",
  "title": "Realmz Providence Canonical Project",
  "description": "The versioned, persisted Providence project contract. The generated seam owns the top-level inventory plus migrated source, scenario-startup, map, map-record, random-level, scenario-item, and treasure DTO families; remaining nested domain DTO schemas are incremental work.",
  "type": "object",
  "additionalProperties": false,
  "x-providence-contract-scope": "persisted-project-top-level",
  "x-providence-derived-fields": ["semanticSchema"],
  "required": [
    "schemaVersion",
    "appVersion",
    "scenario",
    "source",
    "maps",
    "landLayout",
    "mapRecords",
    "tileAttributes",
    "customLandlooks",
    "triggers",
    "randomLevels",
    "extracodes",
    "messages",
    "optionLabels",
    "battles",
    "monsters",
    "monsterSets",
    "monsterDescriptions",
    "monsterIconOverrides",
    "scenarioIconResources",
    "scenarioItems",
    "itemTexts",
    "treasures",
    "shops",
    "simpleEncounters",
    "complexEncounters",
    "thiefEncounters",
    "timedEncounters",
    "questLabels",
    "spellOverrides",
    "raceOverrides",
    "casteOverrides",
    "ruleNames",
    "assets",
    "assetCatalog",
    "editorMetadata",
    "records",
    "diagnostics",
    "validation"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 5,
      "description": "Providence persisted-project schema version."
    },
    "appVersion": { "type": "string" },
    "scenario": { "$ref": "#/$defs/scenarioMeta" },
    "source": { "$ref": "#/$defs/source" },
    "maps": {
      "type": "array",
      "items": { "$ref": "#/$defs/mapEntity" }
    },
    "landLayout": {
      "oneOf": [
        { "$ref": "#/$defs/landLayout" },
        { "type": "null" }
      ]
    },
    "mapRecords": {
      "type": "array",
      "items": { "$ref": "#/$defs/mapRecord" }
    },
    "tileAttributes": { "$ref": "#/$defs/canonicalRecordArray" },
    "customLandlooks": { "$ref": "#/$defs/canonicalRecordArray" },
    "triggers": { "$ref": "#/$defs/canonicalRecordArray" },
    "randomLevels": {
      "type": "array",
      "items": { "$ref": "#/$defs/randomLevel" }
    },
    "extracodes": { "$ref": "#/$defs/canonicalRecordArray" },
    "messages": { "$ref": "#/$defs/canonicalRecordArray" },
    "optionLabels": { "$ref": "#/$defs/canonicalRecordArray" },
    "battles": { "$ref": "#/$defs/canonicalRecordArray" },
    "monsters": { "$ref": "#/$defs/canonicalRecordArray" },
    "monsterSets": { "$ref": "#/$defs/canonicalRecordArray" },
    "monsterDescriptions": { "$ref": "#/$defs/canonicalRecordArray" },
    "monsterIconOverrides": { "$ref": "#/$defs/canonicalRecordArray" },
    "scenarioIconResources": { "$ref": "#/$defs/canonicalRecordArray" },
    "scenarioItems": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenarioItemRecord" }
    },
    "itemTexts": { "$ref": "#/$defs/canonicalRecordArray" },
    "treasures": {
      "type": "array",
      "items": { "$ref": "#/$defs/treasureRecord" }
    },
    "shops": { "$ref": "#/$defs/canonicalRecordArray" },
    "simpleEncounters": { "$ref": "#/$defs/canonicalRecordArray" },
    "complexEncounters": { "$ref": "#/$defs/canonicalRecordArray" },
    "thiefEncounters": { "$ref": "#/$defs/canonicalRecordArray" },
    "timedEncounters": { "$ref": "#/$defs/canonicalRecordArray" },
    "questLabels": { "$ref": "#/$defs/canonicalRecordArray" },
    "spellOverrides": { "$ref": "#/$defs/canonicalRecordArray" },
    "raceOverrides": { "$ref": "#/$defs/canonicalRecordArray" },
    "casteOverrides": { "$ref": "#/$defs/canonicalRecordArray" },
    "ruleNames": { "$ref": "#/$defs/canonicalObject" },
    "assets": { "$ref": "#/$defs/canonicalRecordArray" },
    "assetCatalog": { "$ref": "#/$defs/canonicalObject" },
    "editorMetadata": { "$ref": "#/$defs/canonicalObject" },
    "records": { "$ref": "#/$defs/canonicalObject" },
    "diagnostics": { "$ref": "#/$defs/canonicalRecordArray" },
    "validation": { "$ref": "#/$defs/canonicalObject" }
  },
  "$defs": {
    "levelType": {
      "type": "string",
      "enum": ["land", "dungeon"],
      "x-providence-typescript-name": "ProvidenceLevelType",
      "x-providence-rust-name": "LevelType",
      "x-providence-rust-derives": ["Debug", "Clone", "Copy", "Serialize", "Deserialize", "PartialEq", "Eq", "PartialOrd", "Ord"]
    },
    "renderMode": {
      "type": "string",
      "enum": ["outdoor-landlook", "dungeon-top-down", "abstract-fallback"],
      "x-providence-typescript-name": "ProvidenceRenderMode",
      "x-providence-rust-name": "RenderMode"
    },
    "mapRender": {
      "type": "object",
      "additionalProperties": false,
      "x-providence-typescript-name": "ProvidenceMapRender",
      "x-providence-rust-name": "MapRender",
      "x-providence-rust-optional": ["landlook"],
      "required": ["tilesetId", "landlook", "mode"],
      "properties": {
        "tilesetId": { "type": "string" },
        "landlook": {
          "oneOf": [
            { "type": "integer", "minimum": -128, "maximum": 127, "x-providence-rust-type": "i8" },
            { "type": "null" }
          ]
        },
        "mode": { "$ref": "#/$defs/renderMode" }
      }
    },
    "mapEntity": {
      "type": "object",
      "additionalProperties": false,
      "x-providence-typescript-name": "ProvidenceMapEntity",
      "x-providence-rust-name": "MapEntity",
      "required": ["id", "levelType", "source", "index", "name", "width", "height", "tiles", "render", "provenance"],
      "properties": {
        "id": { "type": "string" },
        "levelType": { "$ref": "#/$defs/levelType" },
        "source": { "type": "string" },
        "index": { "type": "integer", "minimum": 0, "x-providence-rust-type": "usize" },
        "name": { "type": "string" },
        "width": { "type": "integer", "minimum": 0, "x-providence-rust-type": "usize" },
        "height": { "type": "integer", "minimum": 0, "x-providence-rust-type": "usize" },
        "tiles": { "type": "array", "items": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" } },
        "render": { "$ref": "#/$defs/mapRender" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "landLayout": {
      "type": "object",
      "additionalProperties": false,
      "x-providence-typescript-name": "ProvidenceLandLayout",
      "x-providence-rust-name": "LandLayout",
      "x-providence-rust-optional": ["provenance"],
      "x-providence-rust-default": ["trailingBytes", "authored", "provenance"],
      "required": ["rows", "cols", "cells"],
      "properties": {
        "rows": { "type": "integer", "minimum": 0, "x-providence-rust-type": "usize" },
        "cols": { "type": "integer", "minimum": 0, "x-providence-rust-type": "usize" },
        "cells": { "type": "array", "items": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" } },
        "trailingBytes": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255, "x-providence-rust-type": "u8" }, "x-providence-compatibility-only": true },
        "authored": { "type": "boolean" },
        "provenance": {
          "oneOf": [
            { "$ref": "#/$defs/provenance" },
            { "type": "null" }
          ]
        }
      }
    },
    "randomRect": {
      "type": "object",
      "additionalProperties": false,
      "x-providence-typescript-name": "ProvidenceRandomRect",
      "x-providence-rust-name": "RandomRect",
      "required": ["rectIndex", "top", "left", "bottom", "right", "percent", "battleRange", "randomDoors", "randomDoorPercent", "only", "option", "sound", "text"],
      "properties": {
        "rectIndex": { "type": "integer", "minimum": 0, "maximum": 19, "x-providence-rust-type": "usize" },
        "top": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "left": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "bottom": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "right": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "percent": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "battleRange": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" }, "x-providence-rust-type": "[i16; 2]" },
        "randomDoors": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" }, "x-providence-rust-type": "[i16; 3]" },
        "randomDoorPercent": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" }, "x-providence-rust-type": "[i16; 3]" },
        "only": { "type": "boolean" },
        "option": { "type": "integer", "minimum": -128, "maximum": 127, "x-providence-rust-type": "i8" },
        "sound": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "text": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" }
      }
    },
    "randomLevel": {
      "type": "object",
      "additionalProperties": false,
      "x-providence-typescript-name": "ProvidenceRandomLevel",
      "x-providence-rust-name": "RandomLevel",
      "x-providence-rust-default": ["rawValues"],
      "x-providence-rust-skip-empty": ["rawValues"],
      "required": ["id", "source", "levelType", "levelIndex", "landlook", "isDark", "useLos", "rects", "provenance"],
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "levelType": { "$ref": "#/$defs/levelType" },
        "levelIndex": { "type": "integer", "minimum": 0, "x-providence-rust-type": "usize" },
        "landlook": { "type": "integer", "minimum": -128, "maximum": 127, "x-providence-rust-type": "i8" },
        "isDark": { "type": "boolean" },
        "useLos": { "type": "boolean" },
        "rects": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/randomRect" } },
        "rawValues": { "type": "array", "minItems": 322, "maxItems": 322, "items": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" }, "x-providence-compatibility-only": true },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "mapMarker": {
      "type": "object",
      "additionalProperties": false,
      "x-providence-typescript-name": "ProvidenceMapMarker",
      "x-providence-rust-name": "MapMarker",
      "required": ["iconId", "x", "y"],
      "properties": {
        "iconId": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "x": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "y": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" }
      }
    },
    "mapRecordRect": {
      "type": "object",
      "additionalProperties": false,
      "x-providence-typescript-name": "ProvidenceMapRecordRect",
      "x-providence-rust-name": "MapRecordRect",
      "required": ["top", "left", "bottom", "right"],
      "properties": {
        "top": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "left": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "bottom": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "right": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" }
      }
    },
    "mapRecord": {
      "type": "object",
      "additionalProperties": false,
      "x-providence-typescript-name": "ProvidenceMapRecord",
      "x-providence-rust-name": "MapRecord",
      "x-providence-rust-optional": ["name", "primaryName", "secondaryName", "nameSource"],
      "x-providence-rust-default": ["markers", "name", "primaryName", "secondaryName", "nameSource", "mapNameAuthored", "rawBytes", "authored"],
      "x-providence-rust-skip-empty": ["rawBytes"],
      "required": ["id", "markers", "startX", "startY", "level", "pictId", "iconSize", "show", "isDungeon", "rect", "note", "provenance"],
      "properties": {
        "id": { "type": "integer", "minimum": 0, "x-providence-rust-type": "usize" },
        "markers": { "type": "array", "minItems": 10, "maxItems": 10, "items": { "$ref": "#/$defs/mapMarker" } },
        "startX": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "startY": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "level": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "pictId": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "iconSize": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "show": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "isDungeon": { "type": "boolean" },
        "rect": { "$ref": "#/$defs/mapRecordRect" },
        "note": { "type": "string" },
        "name": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "primaryName": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "secondaryName": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "nameSource": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "mapNameAuthored": { "type": "boolean" },
        "rawBytes": { "type": "array", "minItems": 340, "maxItems": 340, "items": { "type": "integer", "minimum": 0, "maximum": 255, "x-providence-rust-type": "u8" }, "x-providence-compatibility-only": true },
        "authored": { "type": "boolean" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "scenarioItemRecord": {
      "type": "object",
      "additionalProperties": false,
      "x-providence-typescript-name": "ProvidenceScenarioItemRecord",
      "x-providence-rust-name": "ScenarioItemRecord",
      "x-providence-rust-default": ["spare2", "rawBytes", "authored"],
      "x-providence-rust-skip-empty": ["rawBytes"],
      "required": ["id", "itemId", "iconId", "type", "st", "blunt", "hands", "lu", "movement", "ac", "magicResistance", "damage", "spellPoints", "sound", "weight", "cost", "charge", "cursedItemId", "magical", "itemCat0", "itemCat1", "raceRestrictions", "casteRestrictions", "specificRace", "specificCaste", "raceClassOnly", "casteClassOnly", "spare2", "vSmall", "vLarge", "heat", "cold", "electric", "vsUndead", "vsDemonDevil", "vsEvil", "special1", "special2", "special3", "special4", "special5", "weightPerCharge", "dropOnEmpty", "provenance"],
      "properties": {
        "id": { "type": "integer", "minimum": 0, "x-providence-rust-type": "usize" },
        "itemId": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "iconId": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "type": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16", "x-providence-rust-field-name": "item_type" },
        "st": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "blunt": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "hands": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "lu": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "movement": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "ac": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "magicResistance": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "damage": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "spellPoints": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "sound": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "weight": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "cost": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "charge": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "cursedItemId": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "magical": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "itemCat0": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647, "x-providence-rust-type": "i32" },
        "itemCat1": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647, "x-providence-rust-type": "i32" },
        "raceRestrictions": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "casteRestrictions": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "specificRace": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "specificCaste": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "raceClassOnly": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "casteClassOnly": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "spare2": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" } },
        "vSmall": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "vLarge": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "heat": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "cold": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "electric": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "vsUndead": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "vsDemonDevil": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "vsEvil": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "special1": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "special2": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "special3": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "special4": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "special5": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "weightPerCharge": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "dropOnEmpty": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "rawBytes": { "type": "array", "minItems": 100, "maxItems": 100, "items": { "type": "integer", "minimum": 0, "maximum": 255, "x-providence-rust-type": "u8" }, "x-providence-compatibility-only": true },
        "authored": { "type": "boolean" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "treasureRecord": {
      "type": "object",
      "additionalProperties": false,
      "x-providence-typescript-name": "ProvidenceTreasureRecord",
      "x-providence-rust-name": "TreasureRecord",
      "x-providence-rust-default": ["itemIds", "rawBytes", "authored"],
      "x-providence-rust-skip-empty": ["rawBytes"],
      "required": ["id", "itemIds", "exp", "gold", "gems", "jewelry", "provenance"],
      "properties": {
        "id": { "type": "integer", "minimum": 0, "x-providence-rust-type": "usize" },
        "itemIds": { "type": "array", "minItems": 20, "maxItems": 20, "items": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" } },
        "exp": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "gold": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "gems": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "jewelry": { "type": "integer", "minimum": -32768, "maximum": 32767, "x-providence-rust-type": "i16" },
        "rawBytes": { "type": "array", "minItems": 48, "maxItems": 48, "items": { "type": "integer", "minimum": 0, "maximum": 255, "x-providence-rust-type": "u8" }, "x-providence-compatibility-only": true },
        "authored": { "type": "boolean" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "scenarioMeta": {
      "type": "object",
      "additionalProperties": false,
      "x-providence-typescript-name": "ProvidenceScenarioMeta",
