{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isynic.github.io/realmz-providence/schemas/providence-project.schema.json",
  "title": "Realmz Providence Canonical Project",
  "description": "The versioned, persisted Providence project contract. The generated seam owns the top-level project inventory plus source-origin and source-file DTOs; remaining nested domain DTO schemas are incremental work.",
  "type": "object",
  "additionalProperties": false,
  "x-providence-contract-scope": "persisted-project-top-level",
  "x-providence-derived-fields": ["semanticSchema"],
  "required": [
    "schemaVersion",
    "appVersion",
    "scenario",
    "source",
    "maps",
    "landLayout",
    "mapRecords",
    "tileAttributes",
    "customLandlooks",
    "triggers",
    "randomLevels",
    "extracodes",
    "messages",
    "optionLabels",
    "battles",
    "monsters",
    "monsterSets",
    "monsterDescriptions",
    "monsterIconOverrides",
    "scenarioIconResources",
    "scenarioItems",
    "itemTexts",
    "treasures",
    "shops",
    "simpleEncounters",
    "complexEncounters",
    "thiefEncounters",
    "timedEncounters",
    "questLabels",
    "spellOverrides",
    "raceOverrides",
    "casteOverrides",
    "ruleNames",
    "assets",
    "assetCatalog",
    "editorMetadata",
    "records",
    "diagnostics",
    "validation"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 5,
      "description": "Providence persisted-project schema version."
    },
    "appVersion": { "type": "string" },
    "scenario": { "$ref": "#/$defs/scenarioMeta" },
    "source": { "$ref": "#/$defs/source" },
    "maps": { "$ref": "#/$defs/canonicalRecordArray" },
    "landLayout": {
      "oneOf": [
        { "$ref": "#/$defs/canonicalObject" },
        { "type": "null" }
      ]
    },
    "mapRecords": { "$ref": "#/$defs/canonicalRecordArray" },
    "tileAttributes": { "$ref": "#/$defs/canonicalRecordArray" },
    "customLandlooks": { "$ref": "#/$defs/canonicalRecordArray" },
    "triggers": { "$ref": "#/$defs/canonicalRecordArray" },
    "randomLevels": { "$ref": "#/$defs/canonicalRecordArray" },
    "extracodes": { "$ref": "#/$defs/canonicalRecordArray" },
    "messages": { "$ref": "#/$defs/canonicalRecordArray" },
    "optionLabels": { "$ref": "#/$defs/canonicalRecordArray" },
    "battles": { "$ref": "#/$defs/canonicalRecordArray" },
    "monsters": { "$ref": "#/$defs/canonicalRecordArray" },
    "monsterSets": { "$ref": "#/$defs/canonicalRecordArray" },
    "monsterDescriptions": { "$ref": "#/$defs/canonicalRecordArray" },
    "monsterIconOverrides": { "$ref": "#/$defs/canonicalRecordArray" },
    "scenarioIconResources": { "$ref": "#/$defs/canonicalRecordArray" },
    "scenarioItems": { "$ref": "#/$defs/canonicalRecordArray" },
    "itemTexts": { "$ref": "#/$defs/canonicalRecordArray" },
    "treasures": { "$ref": "#/$defs/canonicalRecordArray" },
    "shops": { "$ref": "#/$defs/canonicalRecordArray" },
    "simpleEncounters": { "$ref": "#/$defs/canonicalRecordArray" },
    "complexEncounters": { "$ref": "#/$defs/canonicalRecordArray" },
    "thiefEncounters": { "$ref": "#/$defs/canonicalRecordArray" },
    "timedEncounters": { "$ref": "#/$defs/canonicalRecordArray" },
    "questLabels": { "$ref": "#/$defs/canonicalRecordArray" },
    "spellOverrides": { "$ref": "#/$defs/canonicalRecordArray" },
    "raceOverrides": { "$ref": "#/$defs/canonicalRecordArray" },
    "casteOverrides": { "$ref": "#/$defs/canonicalRecordArray" },
    "ruleNames": { "$ref": "#/$defs/canonicalObject" },
    "assets": { "$ref": "#/$defs/canonicalRecordArray" },
    "assetCatalog": { "$ref": "#/$defs/canonicalObject" },
    "editorMetadata": { "$ref": "#/$defs/canonicalObject" },
    "records": { "$ref": "#/$defs/canonicalObject" },
    "diagnostics": { "$ref": "#/$defs/canonicalRecordArray" },
    "validation": { "$ref": "#/$defs/canonicalObject" }
  },
  "$defs": {
    "scenarioMeta": {
      "type": "object",
      "additionalProperties": false,
      "x-providence-typescript-name": "ProvidenceScenarioMeta",
      "x-providence-rust-name": "ScenarioMeta",
      "x-providence-rust-optional": ["shell", "supportFile", "contactInfo", "restrictions", "globalMacroHooks", "securityBackup"],
      "x-providence-rust-default": ["id", "shell", "supportFile", "contactInfo", "restrictions", "globalMacroHooks", "securityBackup"],
      "required": ["name", "projectPath", "importedAt"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "projectPath": { "type": "string" },
        "importedAt": { "type": "string" },
        "shell": {
          "oneOf": [
            { "$ref": "#/$defs/scenarioShell" },
            { "type": "null" }
          ]
        },
        "supportFile": {
          "oneOf": [
            { "$ref": "#/$defs/scenarioSupportFile" },
            { "type": "null" }
          ]
        },
        "contactInfo": {
          "oneOf": [
            { "$ref": "#/$defs/scenarioContactInfo" },
            { "type": "null" }
          ]
        },
        "restrictions": {
          "oneOf": [
            { "$ref": "#/$defs/scenarioRestrictions" },
            { "type": "null" }
          ]
        },
        "globalMacroHooks": {
          "oneOf": [
            { "$ref": "#/$defs/scenarioGlobalMacroHooks" },
            { "type": "null" }
          ]
        },
        "securityBackup": {
          "oneOf": [
            { "$ref": "#/$defs/scenarioShell" },
            { "type": "null" }
          ]
        }
      }
    },
    "scenarioShell": {
      "type": "object",
      "additionalProperties": false,
      "x-providence-typescript-name": "ProvidenceScenarioShell",
      "x-providence-rust-name": "ScenarioShell",
      "x-providence-rust-optional": ["provenance"],
      "x-providence-rust-default": ["codeseg1", "codeseg2", "trailingBytes", "rawBytes", "authored", "provenance"],
      "required": ["sourceFile", "recLevel", "maxLevel", "landLevel", "lookX", "lookY", "creatorUser", "codeseg1", "codeseg2", "trailingBytes"],
      "properties": {
        "sourceFile": { "type": "string" },
        "recLevel": { "type": "integer", "x-providence-rust-type": "i32" },
        "maxLevel": { "type": "integer", "x-providence-rust-type": "i32" },
        "landLevel": { "type": "integer", "x-providence-rust-type": "i32" },
        "lookX": { "type": "integer", "x-providence-rust-type": "i32" },
        "lookY": { "type": "integer", "x-providence-rust-type": "i32" },
        "creatorUser": { "type": "string" },
        "codeseg1": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255, "x-providence-rust-type": "u8" } },
        "codeseg2": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255, "x-providence-rust-type": "u8" } },
        "trailingBytes": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255, "x-providence-rust-type": "u8" }, "x-providence-compatibility-only": true },
        "rawBytes": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255, "x-providence-rust-type": "u8" }, "x-providence-compatibility-only": true },
        "authored": { "type": "boolean" },
        "provenance": {
          "oneOf": [
            { "$ref": "#/$defs/provenanceReference" },
            { "type": "null" }
          ]
        }
      }
    },
    "scenarioSupportFile": {
      "type": "object",
      "additionalProperties": false,
      "x-providence-typescript-name": "ProvidenceScenarioSupportFile",
      "x-providence-rust-name": "ScenarioSupportFile",
      "x-providence-rust-optional": ["divinityStringEditorSlot", "divinityStringSoundId", "provenance"],
      "x-providence-rust-default": ["divinityStringEditorSlot", "divinityStringSoundId", "rawBytes", "authored", "provenance"],
      "required": ["sourceFile"],
      "properties": {
        "sourceFile": { "type": "string" },
        "divinityStringEditorSlot": {
          "oneOf": [
            { "type": "integer", "x-providence-rust-type": "i32" },
            { "type": "null" }
          ]
        },
        "divinityStringSoundId": {
          "oneOf": [
            { "type": "integer", "x-providence-rust-type": "i32" },
            { "type": "null" }
          ]
        },
        "rawBytes": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255, "x-providence-rust-type": "u8" }, "x-providence-compatibility-only": true },
        "authored": { "type": "boolean" },
        "provenance": {
          "oneOf": [
            { "$ref": "#/$defs/provenanceReference" },
            { "type": "null" }
          ]
        }
      }
    },
    "scenarioContactInfo": {
      "type": "object",
      "additionalProperties": false,
      "x-providence-typescript-name": "ProvidenceScenarioContactInfo",
      "x-providence-rust-name": "ScenarioContactInfo",
      "x-providence-rust-optional": ["provenance"],
      "x-providence-rust-default": ["payInfo", "titles", "rawBytes", "authored", "provenance"],
      "required": ["scenarioName", "version", "date", "author", "email", "web", "fee", "payInfo", "titles", "description"],
      "properties": {
        "scenarioName": { "type": "string" },
        "version": { "type": "string" },
        "date": { "type": "string" },
        "author": { "type": "string" },
        "email": { "type": "string" },
        "web": { "type": "string" },
        "fee": { "type": "string" },
        "payInfo": { "type": "array", "items": { "type": "string" } },
        "titles": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "rawBytes": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255, "x-providence-rust-type": "u8" }, "x-providence-compatibility-only": true },
        "authored": { "type": "boolean" },
        "provenance": {
          "oneOf": [
            { "$ref": "#/$defs/provenanceReference" },
            { "type": "null" }
          ]
        }
      }
    },
    "scenarioRestrictions": {
      "type": "object",
      "additionalProperties": false,
      "x-providence-typescript-name": "ProvidenceScenarioRestrictions",
      "x-providence-rust-name": "ScenarioRestrictions",
      "x-providence-rust-optional": ["provenance"],
      "x-providence-rust-default": ["bannedRaces", "bannedCastes", "rawBytes", "authored", "provenance"],
      "required": ["description", "maxPartyCharacters", "maxPartyLevel", "bannedRaces", "bannedCastes"],
      "properties": {
        "description": { "type": "string" },
        "maxPartyCharacters": { "type": "integer", "x-providence-rust-type": "i16" },
        "maxPartyLevel": { "type": "integer", "x-providence-rust-type": "i16" },
        "bannedRaces": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255, "x-providence-rust-type": "u8" } },
        "bannedCastes": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255, "x-providence-rust-type": "u8" } },
        "rawBytes": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255, "x-providence-rust-type": "u8" }, "x-providence-compatibility-only": true },
        "authored": { "type": "boolean" },
        "provenance": {
          "oneOf": [
            { "$ref": "#/$defs/provenanceReference" },
            { "type": "null" }
          ]
        }
      }
    },
    "globalMacroHook": {
      "type": "object",
      "additionalProperties": false,
      "x-providence-typescript-name": "ProvidenceGlobalMacroHook",
      "x-providence-rust-name": "GlobalMacroHook",
      "required": ["slot", "label", "door", "sourceBacked", "runtimeConsumer"],
      "properties": {
        "slot": { "type": "integer", "minimum": 0, "x-providence-rust-type": "usize" },
        "label": { "type": "string" },
        "door": { "type": "integer", "x-providence-rust-type": "i16" },
        "sourceBacked": { "type": "boolean" },
        "runtimeConsumer": { "type": "string" }
      }
    },
    "scenarioGlobalMacroHooks": {
      "type": "object",
      "additionalProperties": false,
      "x-providence-typescript-name": "ProvidenceScenarioGlobalMacroHooks",
      "x-providence-rust-name": "ScenarioGlobalMacroHooks",
      "x-providence-rust-optional": ["provenance"],
      "x-providence-rust-default": ["rawBytes", "authored", "provenance"],
      "required": ["slots"],
      "properties": {
        "slots": { "type": "array", "items": { "$ref": "#/$defs/globalMacroHook" } },
        "rawBytes": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255, "x-providence-rust-type": "u8" }, "x-providence-compatibility-only": true },
        "authored": { "type": "boolean" },
        "provenance": {
          "oneOf": [
            { "$ref": "#/$defs/provenanceReference" },
            { "type": "null" }
          ]
        }
      }
    },
    "provenanceReference": {
      "type": "object",
      "x-providence-external": true,
      "x-providence-typescript-name": "import(\"../types\").Provenance",
      "x-providence-rust-name": "crate::project::Provenance"
    },
    "canonicalObject": {
      "type": "object",
      "description": "A canonical nested DTO whose field-level schema will be generated in a later slice."
    },
    "canonicalRecordArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/canonicalObject" }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "x-providence-typescript-name": "ProvidenceProjectSource",
      "x-providence-typescript-persisted-name": "ProvidencePersistedProjectSource",
      "x-providence-rust-name": "SourceSnapshot",
      "x-providence-runtime-optional": ["origin"],
      "x-providence-rust-skip-none": ["origin"],
      "required": ["origin", "sourcePath", "rawSourcesDir", "files", "immutable"],
      "properties": {
        "origin": {
          "$ref": "#/$defs/projectOrigin",
          "description": "Authored projects compile from canonical data; imported projects may consult the compatibility annex."
        },
        "sourcePath": { "type": "string" },
        "rawSourcesDir": {
          "type": "string",
          "description": "Compatibility-annex location. It is empty for normal authored projects."
        },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceFile" }
        },
        "immutable": { "type": "boolean" }
      }
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "x-providence-typescript-name": "ProvidenceSourceFile",
      "x-providence-rust-name": "SourceFile",
      "required": ["name", "relativePath", "bytes", "sha256", "role", "editable"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "relativePath": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0, "x-providence-rust-type": "u64" },
        "sha256": { "type": "string" },
        "role": { "$ref": "#/$defs/sourceFileRole" },
        "editable": { "type": "boolean" }
      }
    },
    "projectOrigin": {
      "type": "string",
      "enum": ["authored", "imported"],
      "x-providence-typescript-name": "ProvidenceProjectOrigin",
      "x-providence-rust-name": "ProjectOrigin",
      "x-providence-rust-derives": ["Debug", "Clone", "Copy", "Serialize", "Deserialize", "PartialEq", "Eq"]
    },
    "sourceFileRole": {
      "type": "string",
      "enum": ["supported-binary", "pass-through", "resource-fork", "unknown"],
      "x-providence-typescript-name": "ProvidenceSourceFileRole",
      "x-providence-rust-name": "SourceFileRole",
      "x-providence-rust-derives": ["Debug", "Clone", "Serialize", "Deserialize"]
    }
  }
}
