      },
      {
        "id": "timedEncounters",
        "path": "Data TD3"
      },
      {
        "id": "simpleEncounters",
        "path": "Data ED"
      },
      {
        "id": "complexEncounters",
        "path": "Data ED2"
      },
      {
        "id": "monsters",
        "path": "Data MD"
      }
    ]
  }
}
