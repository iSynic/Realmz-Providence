{
  "contractVersion": 7,
  "nativeLayout": {
    "mapField": {
      "dimension": 90,
      "cellBytes": 2
    },
    "randomLevel": {
      "recordBytes": 644
    },
    "actionPoint": {
      "recordBytes": 40,
      "recordsPerLevel": 100
    },
    "extraCode": {
      "recordBytes": 10
    },
    "encounter": {
      "simpleRecordBytes": 426,
      "complexRecordBytes": 520,
      "thiefRecordBytes": 118,
      "timedRecordBytes": 40
    },
    "combat": {
      "battleRecordBytes": 346,
      "monsterRecordBytes": 210,
      "monsterDescriptionRecordBytes": 256
    },
    "economy": {
      "scenarioItemRecordBytes": 100,
      "treasureRecordBytes": 48,
      "shopRecordBytes": 3002
    },
    "text": {
      "messageRecordBytes": 256,
      "optionLabelRecordBytes": 25
    }
  },
  "authoredBaseline": {
    "scenarioItemRecords": 200,
    "startupFiles": {
      "scenarioSupport": "Scenario",
      "securityBackup": "Data CS",
      "scenarioItems": "Data NI",
      "tileSolids": "Data Solids",
      "resourceForkByTarget": {
        "windows-realmz-folder": "Scenario.rsrc",
        "mac-classic-folder": "Scenario.rsrc",
        "providence-portable-folder": "Scenario.rsrc"
      }
    },
    "triggerTables": [
      {
        "path": "Data DD",
        "levelType": "land",
        "minimumLevels": 1
      },
      {
        "path": "Data DDD",
        "levelType": "dungeon",
        "minimumLevels": 0
      }
    ],
    "optionalSemanticFiles": [
      {
        "id": "landMaps",
        "path": "Data LD",
        "presence": {
          "kind": "collection-match",
          "projectPath": "/maps",
          "field": "levelType",
          "equals": "land"
        }
      },
      {
        "id": "landRandomLevels",
        "path": "Data RD",
        "presence": {
          "kind": "collection-match",
          "projectPath": "/randomLevels",
          "field": "levelType",
          "equals": "land"
        }
      },
      {
        "id": "macroActions",
        "path": "Data ED3",
        "presence": {
          "kind": "collection-match",
          "projectPath": "/triggers",
          "field": "source",
          "equals": "Data ED3"
        }
      },
      {
        "id": "extraCodes",
        "path": "Data EDCD",
        "presence": {
          "kind": "collection-non-empty",
          "projectPath": "/extracodes"
        }
      },
      {
        "id": "contactInfo",
        "path": "Data CI",
        "presence": {
          "kind": "present",
          "projectPath": "/scenario/contactInfo"
        }
      },
      {
        "id": "restrictions",
        "path": "Data RI",
        "presence": {
          "kind": "present",
          "projectPath": "/scenario/restrictions"
        }
      },
      {
        "id": "globalHooks",
        "path": "Global",
        "presence": {
          "kind": "present",
          "projectPath": "/scenario/globalMacroHooks"
        }
      },
      {
        "id": "landLayout",
        "path": "Layout",
        "presence": {
          "kind": "present",
          "projectPath": "/landLayout"
        }
      },
      {
        "id": "messages",
        "path": "Data SD2",
        "presence": {
          "kind": "collection-non-empty",
          "projectPath": "/messages"
        }
      },
      {
        "id": "optionLabels",
        "path": "Data OD",
        "presence": {
          "kind": "collection-non-empty",
          "projectPath": "/optionLabels"
        }
      },
      {
        "id": "mapRecords",
        "path": "Data MD2",
        "presence": {
          "kind": "collection-non-empty",
          "projectPath": "/mapRecords"
        }
      },
      {
        "id": "battles",
        "path": "Data BD",
        "presence": {
          "kind": "collection-non-empty",
          "projectPath": "/battles"
        }
      },
      {
        "id": "monsterDescriptions",
        "path": "Data DES",
        "presence": {
          "kind": "collection-non-empty",
          "projectPath": "/monsterDescriptions"
        }
      },
      {
        "id": "treasures",
        "path": "Data TD",
        "presence": {
          "kind": "collection-non-empty",
          "projectPath": "/treasures"
        }
      },
      {
        "id": "spellOverrides",
        "path": "Data Spell",
        "presence": {
          "kind": "collection-non-empty",
          "projectPath": "/spellOverrides"
        }
      },
      {
        "id": "raceOverrides",
        "path": "Data Race",
        "presence": {
          "kind": "collection-non-empty",
          "projectPath": "/raceOverrides"
        }
      },
      {
        "id": "casteOverrides",
        "path": "Data Caste",
        "presence": {
          "kind": "collection-non-empty",
          "projectPath": "/casteOverrides"
        }
      }
    ],
    "projectPathSemanticFiles": [
      {
        "id": "customLandlooks",
        "projectPath": "/customLandlooks",
        "pathField": "sourceFile",
        "include": {
          "kind": "field-truthy",
          "field": "authored"
        }
      },
      {
        "id": "alternateMonsterSets",
        "projectPath": "/monsterSets",
        "pathField": "sourceFile",
        "include": {
          "kind": "field-collection-non-empty",
          "field": "monsters"
        }
      }
    ],
    "resourceSidecars": [
      {
        "id": "itemTexts",
        "path": "Data ID.rsrc",
        "projectPath": "/itemTexts",
        "emission": "semantic-updates"
      },
      {
        "id": "customSpellNames",
        "path": "Data Spell.rsrc",
        "projectPath": "/spellOverrides",
        "emission": "semantic-updates"
      }
    ],
    "runtimeBaselineFiles": [
      {
        "id": "dungeonMaps",
        "path": "Data DL"
      },
      {
        "id": "dungeonRandomLevels",
        "path": "Data RDD"
      },
      {
