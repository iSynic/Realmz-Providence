{
  "name": "realmz-providence",
  "productName": "Realmz Providence",
  "version": "0.1.22",
  "description": "Modern Realmz scenario editor and creator.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "tauri dev",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "dist": "tauri build",
    "release:desktop-gate": "powershell -ExecutionPolicy Bypass -File scripts/run_desktop_release_gate.ps1",
    "release:desktop-gate:windows": "powershell -ExecutionPolicy Bypass -File scripts/run_desktop_release_gate.ps1 -SkipLinux",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "archaeology:roundtrip-audit": "cargo run --manifest-path src-tauri/Cargo.toml --example no_edit_roundtrip_audit -- --output docs/generated/scenario-byte-roundtrip-ledger.json",
    "archaeology:snapshot": "cargo run --manifest-path src-tauri/Cargo.toml --example canon_scenario_snapshot --",
    "archaeology:diff-snapshots": "cargo run --manifest-path src-tauri/Cargo.toml --example diff_canon_scenarios --",
    "archaeology:prepare-divinity-fixture": "node scripts/divinity_fixture_workflow.mjs prepare",
    "archaeology:capture-divinity-fixture": "node scripts/divinity_fixture_workflow.mjs capture",
    "archaeology:diff-divinity-fixture": "node scripts/divinity_fixture_workflow.mjs diff",
    "archaeology:byte-coverage": "node scripts/generate_scenario_byte_coverage.mjs",
    "archaeology:dungeon-coverage": "node scripts/generate_dungeon_coverage.mjs",
    "archaeology:custom-landlook-coverage": "node scripts/generate_custom_landlook_coverage.mjs",
    "archaeology:rules-coverage": "node scripts/generate_rules_coverage.mjs",
    "archaeology:resource-coverage": "node scripts/generate_resource_coverage.mjs",
    "archaeology:pict-preview-gaps": "node scripts/report_pict_preview_gaps.mjs",
    "archaeology:pict-codec": "node scripts/report_pict_preview_gaps.mjs --out docs/generated/pict-codec-report.md",
    "archaeology:target-compatibility": "node scripts/generate_target_compatibility.mjs",
    "archaeology:smart-terrain": "node scripts/generate_smart_terrain_corpus.mjs",
    "archaeology:divinity-opcodes": "node scripts/extract_divinity_opcode_help.mjs",
    "archaeology:opcode-crosswalk": "node scripts/generate_opcode_edcd_crosswalk.mjs",
    "archaeology:script-diagnostics": "node scripts/report_script_diagnostics.mjs",
    "archaeology:edcd-settings": "node scripts/report_edcd_settings_rows.mjs",
    "archaeology:timed-encounter-fields": "node scripts/report_timed_encounter_reserved_fields.mjs",
    "archaeology:preserved-byte-triage": "node scripts/report_preserved_byte_triage.mjs",
    "archaeology:ap-opcode-coverage": "node scripts/report_ap_opcode_coverage.mjs",
    "archaeology:ap-action-gaps": "node scripts/report_ap_action_gaps.mjs",
    "archaeology:scenario-context": "node scripts/report_scenario_context.mjs",
    "archaeology:quest-context": "node scripts/report_quest_context_coverage.mjs",
    "smoke:oracle": "powershell -ExecutionPolicy Bypass -File scripts/run_oracle_smoke.ps1",
    "smoke:oracle:matrix": "powershell -ExecutionPolicy Bypass -File scripts/run_oracle_smoke_matrix.ps1",
    "smoke:oracle:gameplay": "powershell -ExecutionPolicy Bypass -File scripts/run_oracle_gameplay.ps1",
    "smoke:oracle:gameplay:matrix": "powershell -ExecutionPolicy Bypass -File scripts/run_oracle_gameplay_matrix.ps1",
    "smoke:oracle:corpus": "powershell -ExecutionPolicy Bypass -File scripts/run_oracle_corpus.ps1",
    "smoke:oracle:corpus:matrix": "powershell -ExecutionPolicy Bypass -File scripts/run_oracle_corpus_matrix.ps1",
    "smoke:oracle:corpus:diagnose": "powershell -ExecutionPolicy Bypass -File scripts/run_oracle_corpus_diagnose.ps1",
    "smoke:oracle:corpus:triage": "powershell -ExecutionPolicy Bypass -File scripts/run_oracle_corpus_triage.ps1",
    "smoke:oracle:show": "powershell -ExecutionPolicy Bypass -File scripts/show_oracle_run.ps1",
    "smoke:editor": "powershell -ExecutionPolicy Bypass -File scripts/run_editor_smoke_matrix.ps1",
    "smoke:editor:text-assets": "powershell -ExecutionPolicy Bypass -File scripts/run_text_assets_editor_smoke.ps1",
    "smoke:editor:maps": "powershell -ExecutionPolicy Bypass -File scripts/run_maps_authoring_editor_smoke.ps1",
    "smoke:ui:map-paint": "node scripts/smoke_ui_map_paint.mjs",
    "smoke:ui:performance": "node scripts/smoke_ui_performance.mjs",
    "smoke:editor:scripts-v2": "powershell -ExecutionPolicy Bypass -File scripts/run_scripts_v2_editor_smoke.ps1",
    "smoke:editor:scripts-v2:diagnostics": "powershell -ExecutionPolicy Bypass -File scripts/run_scripts_v2_diagnostics_smoke.ps1",
    "check:ap-action-gaps": "node scripts/report_ap_action_gaps.mjs --self-test && node scripts/report_ap_action_gaps.mjs --fail-on-authoring-gaps --out tmp/ap-action-gaps-check",
    "check:ap-actions": "node scripts/check_action_title_labels.mjs && node scripts/check_script_action_coverage.mjs",
    "check:registration-codes": "node scripts/check_registration_codes.mjs",
    "check:smart-terrain-profiles": "node scripts/check_smart_terrain_profiles.mjs",
    "check:script-diagnostics": "node scripts/report_script_diagnostics.mjs --self-test --out tmp/script-diagnostics-self-test",
    "check:scenario-context": "node scripts/check_scenario_context_registry.mjs",
    "check": "npm run typecheck && npm run check:ap-action-gaps && npm run check:ap-actions && npm run check:registration-codes && npm run check:script-diagnostics && npm run check:scenario-context && npm run build && npm run test:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
