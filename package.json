{
  "name": "realmz-providence",
  "productName": "Realmz Providence",
  "version": "0.1.0",
  "description": "Modern Realmz scenario editor and creator.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "tauri dev",
    "build": "vite build",
    "dist": "tauri build",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "smoke:oracle": "powershell -ExecutionPolicy Bypass -File scripts/run_oracle_smoke.ps1",
    "smoke:oracle:matrix": "powershell -ExecutionPolicy Bypass -File scripts/run_oracle_smoke_matrix.ps1",
    "smoke:oracle:gameplay": "powershell -ExecutionPolicy Bypass -File scripts/run_oracle_gameplay.ps1",
    "smoke:oracle:gameplay:matrix": "powershell -ExecutionPolicy Bypass -File scripts/run_oracle_gameplay_matrix.ps1",
    "smoke:oracle:corpus": "powershell -ExecutionPolicy Bypass -File scripts/run_oracle_corpus.ps1",
    "smoke:oracle:corpus:matrix": "powershell -ExecutionPolicy Bypass -File scripts/run_oracle_corpus_matrix.ps1",
    "smoke:oracle:corpus:diagnose": "powershell -ExecutionPolicy Bypass -File scripts/run_oracle_corpus_diagnose.ps1",
    "smoke:oracle:corpus:triage": "powershell -ExecutionPolicy Bypass -File scripts/run_oracle_corpus_triage.ps1",
    "smoke:oracle:show": "powershell -ExecutionPolicy Bypass -File scripts/show_oracle_run.ps1",
    "check": "npm run build && npm run test:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
