text = "! Missing banned reference: classic.race.42"

[node name="EvidenceDisclosure" type="Button" parent="Content"]
layout_mode = 2
toggle_mode = true
text = "▸ Source evidence"
alignment = 0

[node name="Evidence" type="Label" parent="Content"]
visible = false
layout_mode = 2
theme_type_variation = &"ScenarioSecondary"
text = "Data RI · source retained · read only"

[node name="Keys" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"ScenarioSecondary"
text = "Tab / Shift+Tab traverse; arrows select rows.
Enter opens navigation; Space toggles disclosure.
List Space/Enter never change bans. Text: select/copy.
Hover: accent border 1px. Pressed: selection fill.
Focus: accent border 2px, retained when pressed."

[node name="Result" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"ScenarioSecondary"
text = "Specimen only · no project commands"
