item_1/text = "01 Human · allowed"
item_1/icon = ExtResource("4")
item_2/text = "04 Orc · banned"
item_2/icon = ExtResource("3")

[node name="UnavailableReason" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"ScenarioSecondary"
text = "Editing is not available in this workbench."

[node name="Diagnostic" type="Label" parent="Content"]
layout_mode = 2
