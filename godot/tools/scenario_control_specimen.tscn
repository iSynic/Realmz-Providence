[ext_resource type="Texture2D" path="res://theme/policy_unchecked.svg" id="4"]

[node name="ScenarioControlSpecimen" type="PanelContainer"]
custom_minimum_size = Vector2(512, 610)
theme = ExtResource("1")
script = ExtResource("2")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="Title" type="Label" parent="Content"]
layout_mode = 2
text = "SCENARIO · CONTROL STATES"

[node name="Fixture" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"ScenarioSecondary"
text = "Controlled samples, not records · one real focus owner"
autowrap_mode = 2

[node name="Navigation" type="HBoxContainer" parent="Content"]
layout_mode = 2

[node name="Navigate" type="Button" parent="Content/Navigation"]
layout_mode = 2
size_flags_horizontal = 3
text = "Spells"
alignment = 0

[node name="Unavailable" type="Button" parent="Content/Navigation"]
layout_mode = 2
size_flags_horizontal = 3
disabled = true
text = "Apply changes"
alignment = 0

[node name="FieldLabel" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"ScenarioSecondary"
text = "Scenario name · read only"

[node name="ScenarioName" type="LineEdit" parent="Content"]
layout_mode = 2
text = "The Long Road to Bywater"
editable = false

[node name="ChecklistLegend" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"ScenarioSecondary"
text = "Selection is not a change to admission policy."

[node name="AdmissionPolicy" type="ItemList" parent="Content"]
custom_minimum_size = Vector2(0, 85)
layout_mode = 2
