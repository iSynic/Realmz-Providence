[node name="ComparisonActions" type="HBoxContainer" parent="ComparisonDialog/Body"]
unique_name_in_owner = true
layout_mode = 2

[node name="UseAppliedValues" type="Button" parent="ComparisonDialog/Body/ComparisonActions"]
unique_name_in_owner = true
layout_mode = 2
text = "Use applied values"
theme_override_font_sizes/font_size = 12

[node name="KeepComparedDraft" type="Button" parent="ComparisonDialog/Body/ComparisonActions"]
unique_name_in_owner = true
layout_mode = 2
text = "Keep draft for review"
theme_override_font_sizes/font_size = 12

[node name="FailureDialog" type="Window" parent="."]
unique_name_in_owner = true
layout_mode = 2
title = "Encounter changes could not be confirmed"
size = Vector2i(760, 300)
visible = false
exclusive = true
transient = true
unresizable = true
wrap_controls = false

[node name="Body" type="VBoxContainer" parent="FailureDialog"]
layout_mode = 2
offset_left = 20.0
offset_top = 20.0
offset_right = 740.0
offset_bottom = 280.0
theme_override_constants/separation = 12

[node name="FailureText" type="Label" parent="FailureDialog/Body"]
unique_name_in_owner = true
layout_mode = 2
text = "Your draft is retained."
theme_override_font_sizes/font_size = 12
autowrap_mode = 2

[node name="Actions" type="HBoxContainer" parent="FailureDialog/Body"]
layout_mode = 2

[node name="ReloadLatest" type="Button" parent="FailureDialog/Body/Actions"]
unique_name_in_owner = true
layout_mode = 2
text = "Reload Latest…"
theme_override_font_sizes/font_size = 12

[node name="CheckCurrent" type="Button" parent="FailureDialog/Body/Actions"]
unique_name_in_owner = true
layout_mode = 2
text = "Check Current"
theme_override_font_sizes/font_size = 12

[node name="CloseFailure" type="Button" parent="FailureDialog/Body/Actions"]
unique_name_in_owner = true
layout_mode = 2
text = "Keep Editing"
theme_override_font_sizes/font_size = 12

[node name="CellDialog" type="Window" parent="."]
unique_name_in_owner = true
layout_mode = 2
title = "Choose exact map cell"
size = Vector2i(920, 760)
visible = false
exclusive = true
transient = true
unresizable = true
wrap_controls = false

[node name="Body" type="VBoxContainer" parent="CellDialog"]
layout_mode = 2
offset_left = 20.0
offset_top = 20.0
offset_right = 900.0
offset_bottom = 740.0
theme_override_constants/separation = 12

[node name="CellCanvas" type="Control" parent="CellDialog/Body"]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("cell")
custom_minimum_size = Vector2(0, 540)
size_flags_vertical = 3

[node name="CellContext" type="Label" parent="CellDialog/Body"]
unique_name_in_owner = true
layout_mode = 2
text = ""
theme_override_font_sizes/font_size = 12

[node name="CellXRow" type="HBoxContainer" parent="CellDialog/Body"]
unique_name_in_owner = true
layout_mode = 2

[node name="CellXLabel" type="Label" parent="CellDialog/Body/CellXRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Exact X"
theme_override_font_sizes/font_size = 12

[node name="CellX" type="SpinBox" parent="CellDialog/Body/CellXRow"]
unique_name_in_owner = true
layout_mode = 2
min_value = 0
max_value = 89
allow_greater = false
allow_lesser = false
size_flags_horizontal = 3

[node name="CellYRow" type="HBoxContainer" parent="CellDialog/Body"]
unique_name_in_owner = true
layout_mode = 2

[node name="CellYLabel" type="Label" parent="CellDialog/Body/CellYRow"]
