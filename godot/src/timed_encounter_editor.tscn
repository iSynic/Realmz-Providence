min_value = 0
max_value = 89
allow_greater = false
allow_lesser = false
size_flags_horizontal = 3

[node name="Actions" type="HBoxContainer" parent="CellDialog/Body"]
layout_mode = 2

[node name="CancelCell" type="Button" parent="CellDialog/Body/Actions"]
unique_name_in_owner = true
layout_mode = 2
