[gd_scene load_steps=2 format=3]

[ext_resource path="res://src/problems_dock.gd" type="Script" id="1"]

[node name="ProblemsDock" type="VBoxContainer"]
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
script = ExtResource("1")

[node name="DockHeader" type="HBoxContainer" parent="."]
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
theme_override_constants/separation = 4

[node name="BottomTabs" type="TabBar" parent="DockHeader"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tab_count = 5
tab_0/title = "Problems"
tab_1/title = "Compatibility"
tab_2/title = "Compiler Output"
tab_3/title = "Find Results"
tab_4/title = "Source Evidence"

[node name="ToggleProblemsDock" type="Button" parent="DockHeader"]
unique_name_in_owner = true
layout_mode = 2
text = "Expand"

[node name="ProblemsContent" type="ScrollContainer" parent="."]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(0, 180)
layout_mode = 2
size_flags_vertical = 3

[node name="ProblemRows" type="VBoxContainer" parent="ProblemsContent"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[connection signal="tab_changed" from="DockHeader/BottomTabs" to="." method="_on_tab_changed"]
[connection signal="pressed" from="DockHeader/ToggleProblemsDock" to="." method="_on_toggle_pressed"]
