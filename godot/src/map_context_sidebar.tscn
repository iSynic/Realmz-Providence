[node name="MapCollection" type="ItemList" parent="MapPicker/PickerBody"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 350)
size_flags_vertical = 3
allow_reselect = true

[node name="MapEmptyState" type="Label" parent="MapPicker/PickerBody"]
unique_name_in_owner = true
layout_mode = 2
text = "No maps match this view."
horizontal_alignment = 1

[connection signal="pressed" from="MapRecordActions/NewLand" to="." method="_on_new_land_pressed"]
[connection signal="pressed" from="MapRecordActions/NewDungeon" to="." method="_on_new_dungeon_pressed"]
[connection signal="pressed" from="MapRecordActions/DuplicateMap" to="." method="_on_duplicate_pressed"]
[connection signal="pressed" from="MapToolset/PaintTool" to="." method="_on_paint_tool_pressed"]
[connection signal="pressed" from="MapToolset/SelectTool" to="." method="_on_select_tool_pressed"]

[connection signal="pressed" from="MapToolset/LandTilesTool" to="." method="_on_special_tiles_pressed"]
[connection signal="text_changed" from="MapPicker/PickerBody/MapSearch" to="." method="_on_search_changed"]
[connection signal="item_selected" from="MapPicker/PickerBody/MapCollection" to="." method="_on_collection_selected"]
[connection signal="pressed" from="MapPicker/PickerBody/MapTypeFilters/AllMaps" to="." method="_set_level_filter" binds=["all"]]
[connection signal="pressed" from="MapPicker/PickerBody/MapTypeFilters/LandMaps" to="." method="_set_level_filter" binds=["land"]]
[connection signal="pressed" from="MapPicker/PickerBody/MapTypeFilters/DungeonMaps" to="." method="_set_level_filter" binds=["dungeon"]]
