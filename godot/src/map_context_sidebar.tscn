custom_minimum_size = Vector2(0, 34)
toggle_mode = true
text = "Wand"

[node name="StampTool" type="Button" parent="MapToolset"]
tooltip_text = "Move to preview; release places the stamp. Escape cancels the current stroke."
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 34)
toggle_mode = true
text = "Stamp"

[node name="PanTool" type="Button" parent="MapToolset"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 34)
toggle_mode = true
text = "Pan"

[node name="ActionPointsTool" type="Button" parent="MapToolset"]
tooltip_text = "Click an empty cell to review a placement; click an existing Action Point to open it."
toggle_mode = true
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 34)
text = "Action Point"

[node name="SampleTool" type="Button" parent="MapToolset"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 34)
toggle_mode = true
text = "Sample"

[node name="EraseTool" type="Button" parent="MapToolset"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 34)
toggle_mode = true
text = "Erase"

[node name="SmartTool" type="Button" parent="MapToolset"]
tooltip_text = "Draw an accumulating terrain mask on the map. Apply commits the draft; Escape cancels the current stroke."
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 34)
toggle_mode = true
text = "Smart Terrain"

[node name="RandomAreaTool" type="Button" parent="MapToolset"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
