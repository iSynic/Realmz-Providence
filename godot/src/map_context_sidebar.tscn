[node name="LandTilesTool" type="Button" parent="MapToolset"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 34)
toggle_mode = false
text = "Land Tiles"

[node name="PaintOptions" type="Button" parent="MapToolset"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 34)
toggle_mode = true
text = "Paint options…"

[node name="TerrainMapping" type="Button" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 34)
text = "Terrain Mapping…"

[node name="MagicTool" type="Button" parent="MapToolset"]
tooltip_text = "Press a tile and drag to extend its supported terrain family or exact tile. Strokes accumulate until Apply; later strokes win where they overlap. Escape cancels the current stroke."
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 34)
toggle_mode = true
text = "Magic"

[node name="BrushControlsHost" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
visible = false

[node name="MapPicker" type="PopupPanel" parent="."]
unique_name_in_owner = true
size = Vector2i(420, 510)

[node name="PickerBody" type="VBoxContainer" parent="MapPicker"]
offset_left = 12.0
offset_top = 12.0
offset_right = 408.0
offset_bottom = 498.0

[node name="MapSearch" type="LineEdit" parent="MapPicker/PickerBody"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Filter maps by name or number…"
clear_button_enabled = true

[node name="MapTypeFilters" type="HBoxContainer" parent="MapPicker/PickerBody"]
layout_mode = 2

[node name="AllMaps" type="Button" parent="MapPicker/PickerBody/MapTypeFilters"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
