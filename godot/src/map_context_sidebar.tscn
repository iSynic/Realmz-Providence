[gd_scene load_steps=2 format=3]
[ext_resource path="res://src/map_context_sidebar.gd" type="Script" id="1"]
[node name="MapContextSidebar" type="VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 7
script = ExtResource("1")

[node name="MapBrowserHeader" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Title" type="Label" parent="MapBrowserHeader"]
layout_mode = 2
size_flags_horizontal = 3
text = "SCENARIO MAPS"

[node name="MapCount" type="Label" parent="MapBrowserHeader"]
unique_name_in_owner = true
layout_mode = 2
text = "0 / 0"

[node name="ChooseMap" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 36)
text = "Choose a map…"
text_overrun_behavior = 3

[node name="MapRecordActions" type="GridContainer" parent="."]
layout_mode = 2
columns = 2

[node name="NewLand" type="Button" parent="MapRecordActions"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "New Land"

[node name="NewDungeon" type="Button" parent="MapRecordActions"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "New Dungeon"

[node name="DuplicateMap" type="Button" parent="MapRecordActions"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Duplicate"

[node name="CurrentMapPanel" type="PanelContainer" parent="."]
layout_mode = 2

[node name="Body" type="VBoxContainer" parent="CurrentMapPanel"]
layout_mode = 2

[node name="CurrentMap" type="Label" parent="CurrentMapPanel/Body"]
unique_name_in_owner = true
layout_mode = 2
text = "No map selected"
text_overrun_behavior = 3

[node name="CurrentMapMeta" type="Label" parent="CurrentMapPanel/Body"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2
theme_override_font_sizes/font_size = 10
text = "Import or create a map to begin."

[node name="LevelSetup" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
disabled = true
text = "Level setup…"

[node name="ReconcileLevelSettings" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
visible = false
text = "Reconcile level settings"

[node name="MapToolsetHeading" type="Label" parent="."]
layout_mode = 2
text = "MAP TOOLS"

[node name="MapToolset" type="GridContainer" parent="."]
layout_mode = 2
columns = 2

[node name="PaintTool" type="Button" parent="MapToolset"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 34)
toggle_mode = true
text = "Paint"

[node name="SelectTool" type="Button" parent="MapToolset"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 34)
toggle_mode = true
text = "Select"

[node name="BucketTool" type="Button" parent="MapToolset"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 34)
toggle_mode = true
text = "Bucket"

[node name="WandTool" type="Button" parent="MapToolset"]
unique_name_in_owner = true
layout_mode = 2
