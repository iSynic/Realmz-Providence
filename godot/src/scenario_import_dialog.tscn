[gd_scene load_steps=2 format=3]

[ext_resource path="res://src/scenario_import_dialog.gd" type="Script" id="1"]

[node name="ScenarioImportDialog" type="ConfirmationDialog"]
script = ExtResource("1")

[node name="ScenarioImportForm" type="VBoxContainer" parent="."]
custom_minimum_size = Vector2(820, 500)
theme_override_constants/separation = 12

[node name="ScenarioImportSubtitle" type="Label" parent="ScenarioImportForm"]
unique_name_in_owner = true
theme_override_colors/font_color = Color(0.560784, 0.627451, 0.678431, 1)
text = "Choose a Classic scenario folder."
autowrap_mode = 2

[node name="BoundedImportInvariant" type="PanelContainer" parent="ScenarioImportForm"]

[node name="BoundedImportInvariantText" type="Label" parent="ScenarioImportForm/BoundedImportInvariant"]
unique_name_in_owner = true
theme_override_colors/font_color = Color(0.898039, 0.709804, 0.403922, 1)
text = "Import replaces the current scenario and clears Undo. This cannot be undone."
autowrap_mode = 2

[node name="ScenarioSourceGroup" type="VBoxContainer" parent="ScenarioImportForm"]
size_flags_horizontal = 3

[node name="ScenarioSourceLabel" type="Label" parent="ScenarioImportForm/ScenarioSourceGroup"]
theme_override_colors/font_color = Color(0.560784, 0.627451, 0.678431, 1)
text = "Classic scenario folder"

[node name="ScenarioSourceFolderRow" type="HBoxContainer" parent="ScenarioImportForm/ScenarioSourceGroup"]

[node name="ScenarioSourceFolder" type="LineEdit" parent="ScenarioImportForm/ScenarioSourceGroup/ScenarioSourceFolderRow"]
unique_name_in_owner = true
size_flags_horizontal = 3
placeholder_text = "Choose a folder containing Data NI"

[node name="BrowseScenarioSource" type="Button" parent="ScenarioImportForm/ScenarioSourceGroup/ScenarioSourceFolderRow"]
unique_name_in_owner = true
text = "Browse…"

[node name="ClassicApplicationDataGroup" type="VBoxContainer" parent="ScenarioImportForm"]
size_flags_horizontal = 3

[node name="ClassicApplicationDataLabel" type="Label" parent="ScenarioImportForm/ClassicApplicationDataGroup"]
theme_override_colors/font_color = Color(0.560784, 0.627451, 0.678431, 1)
text = "Realmz reference data"

[node name="ClassicApplicationDataRow" type="HBoxContainer" parent="ScenarioImportForm/ClassicApplicationDataGroup"]

[node name="ClassicApplicationDataFolder" type="LineEdit" parent="ScenarioImportForm/ClassicApplicationDataGroup/ClassicApplicationDataRow"]
unique_name_in_owner = true
size_flags_horizontal = 3
editable = false
placeholder_text = "Bundled Realmz reference data unavailable"

[node name="BundledRealmzDataStatus" type="Label" parent="ScenarioImportForm/ClassicApplicationDataGroup/ClassicApplicationDataRow"]
unique_name_in_owner = true
theme_override_colors/font_color = Color(0.490196, 0.792157, 0.635294, 1)
text = "Included with Providence"

[node name="DetectedContentGroup" type="VBoxContainer" parent="ScenarioImportForm"]
size_flags_horizontal = 3

[node name="DetectedContentLabel" type="Label" parent="ScenarioImportForm/DetectedContentGroup"]
theme_override_colors/font_color = Color(0.560784, 0.627451, 0.678431, 1)
text = "Detected content"

[node name="DetectedScenarioInputs" type="Label" parent="ScenarioImportForm/DetectedContentGroup"]
unique_name_in_owner = true
autowrap_mode = 2

[node name="ImportScopeGroup" type="VBoxContainer" parent="ScenarioImportForm"]
size_flags_horizontal = 3

[node name="ImportScopeLabel" type="Label" parent="ScenarioImportForm/ImportScopeGroup"]
theme_override_colors/font_color = Color(0.560784, 0.627451, 0.678431, 1)
text = "What will be imported"

[node name="ScenarioImportScope" type="Label" parent="ScenarioImportForm/ImportScopeGroup"]
unique_name_in_owner = true
theme_override_colors/font_color = Color(0.721569, 0.764706, 0.807843, 1)
text = "Inspect a source folder to select its first complete certified workflow."
autowrap_mode = 2

[node name="ScenarioImportValidation" type="Label" parent="ScenarioImportForm"]
unique_name_in_owner = true
autowrap_mode = 2

[node name="ScenarioDirectoryPicker" type="FileDialog" parent="."]
unique_name_in_owner = true
file_mode = 2
access = 2
use_native_dialog = true
