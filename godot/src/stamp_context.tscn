[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://src/stamp_context.gd" id="1"]
[ext_resource type="Script" path="res://src/paint_resource_preview.gd" id="2"]

[ext_resource type="Theme" path="res://src/world_controls.tres" id="3"]

[node name="StampContext" type="VBoxContainer"]
tooltip_text = "Release places the stamp. Escape cancels the current stroke."
theme = ExtResource("3")
theme_override_constants/separation = 12
script = ExtResource("1")

[node name="Heading" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"WorldTitle"
text = "STAMP"

[node name="StampName" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_type_variation = &"WorldUsesHeading"
text = "Selected stamp"
autowrap_mode = 2

[node name="StampDimensions" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2

[node name="StampArtwork" type="TextureRect" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 128)
layout_mode = 2
texture_filter = 1
expand_mode = 1
stretch_mode = 5
script = ExtResource("2")

[node name="ChooseStamp" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "Choose stamp…"

[node name="Instructions" type="Label" parent="."]
visible = false
layout_mode = 2
text = "Release to place. Escape cancels the stroke."
autowrap_mode = 2

[node name="PlacementStatus" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "Ready to place"
autowrap_mode = 2

[node name="RetryPlacement" type="Button" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
text = "Retry placement"

[node name="DiscardPlacement" type="Button" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
text = "Discard placement"

[node name="CheckPlacement" type="Button" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
text = "Check original placement"

[node name="StampOwnership" type="Label" parent="."]
theme_type_variation = &"WorldHint"
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2
