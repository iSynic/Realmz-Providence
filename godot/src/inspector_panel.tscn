[gd_scene load_steps=2 format=3]

[ext_resource path="res://src/inspector_panel.gd" type="Script" id="1"]

[node name="InspectorPanel" type="PanelContainer"]
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
size_flags_vertical = 3
script = ExtResource("1")

[node name="InspectorScroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="InspectorBody" type="VBoxContainer" parent="InspectorScroll"]
custom_minimum_size = Vector2(272, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="InspectorHeader" type="HBoxContainer" parent="InspectorScroll/InspectorBody"]
layout_mode = 2

[node name="InspectorTitle" type="Label" parent="InspectorScroll/InspectorBody/InspectorHeader"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.839216, 0.721569, 0.458824, 1)
text = "INSPECTOR  ·  LINKS / USES"

[node name="InspectorMode" type="Label" parent="InspectorScroll/InspectorBody/InspectorHeader"]
layout_mode = 2
theme_override_colors/font_color = Color(0.619608, 0.694118, 0.760784, 1)
theme_override_font_sizes/font_size = 10
text = "CELL"

[node name="ReferenceHeading" type="Label" parent="InspectorScroll/InspectorBody"]
layout_mode = 2
theme_override_colors/font_color = Color(0.619608, 0.694118, 0.760784, 1)
theme_override_font_sizes/font_size = 10
text = "SELECTED FIELD / TARGET"

[node name="CurrentReferenceTarget" type="Label" parent="InspectorScroll/InspectorBody"]
unique_name_in_owner = true
layout_mode = 2
