[node name="LayoutGridToggle" type="CheckBox" parent="LayoutScaling"]
unique_name_in_owner = true
layout_mode = 2
button_pressed = true
text = "Grid"
tooltip_text = "Show cell borders over map previews. Turning off the grid keeps selection and exact cell positions."

[node name="LayoutWorkbench" type="HSplitContainer" parent="."]
