disabled = true
text = "Clear Layout"

[node name="LayoutScaling" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="LayoutZoomOut" type="Button" parent="LayoutScaling"]
unique_name_in_owner = true
layout_mode = 2
