tooltip_text = "Zoom in"

[node name="LayoutFit" type="Button" parent="LayoutScaling"]
unique_name_in_owner = true
layout_mode = 2
text = "Fit layout"

[node name="LayoutFitAssigned" type="Button" parent="LayoutScaling"]
unique_name_in_owner = true
layout_mode = 2
text = "Fit assigned"
