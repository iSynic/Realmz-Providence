[node name="LandLayoutEditor" type="VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
script = ExtResource("1")

[node name="WorldSections" parent="." instance=ExtResource("4")]
unique_name_in_owner = true
selected_section = "LandLayout"

[node name="LayoutHeader" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="LayoutHeaderCopy" type="VBoxContainer" parent="LayoutHeader"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Title" type="Label" parent="LayoutHeader/LayoutHeaderCopy"]
