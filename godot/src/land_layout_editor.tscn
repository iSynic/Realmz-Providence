text = "−"

[node name="LayoutZoom" type="Label" parent="LayoutScaling"]
unique_name_in_owner = true
custom_minimum_size = Vector2(54,0)
layout_mode = 2
horizontal_alignment = 1
text = "100%"
tooltip_text = "100% uses 180 pixels per map. Wheel to zoom; middle drag to pan."

[node name="LayoutZoomIn" type="Button" parent="LayoutScaling"]
unique_name_in_owner = true
layout_mode = 2
