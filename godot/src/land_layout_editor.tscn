theme_type_variation = &"WorldTitle"
text = "Land Layout"

[node name="LayoutStatus" type="Label" parent="LayoutHeader/LayoutHeaderCopy"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.619608, 0.694118, 0.760784, 1)
text = "No layout projection loaded"

[node name="ClearLayout" type="Button" parent="LayoutHeader"]
unique_name_in_owner = true
layout_mode = 2
