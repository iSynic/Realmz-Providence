[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/monster_scenario_inventory.gd" id="1"]

[node name="ScenarioMonsterList" type="VBoxContainer"]
custom_minimum_size = Vector2(265, 0)
