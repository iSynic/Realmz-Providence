[ext_resource type="Script" path="res://src/map_image_export_dialog.gd" id="1"]

[node name="MapImageExport" type="ConfirmationDialog"]
title = "Export Map Image"
size = Vector2i(480, 260)
script = ExtResource("1")

[node name="Options" type="VBoxContainer" parent="."]
offset_left = 12.0
offset_top = 12.0
offset_right = -12.0
offset_bottom = -48.0
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/separation = 10

[node name="Size" type="HBoxContainer" parent="Options"]
layout_mode = 2

[node name="Label" type="Label" parent="Options/Size"]
layout_mode = 2
custom_minimum_size = Vector2(95, 0)
text = "Image size"

[node name="ExportScale" type="OptionButton" parent="Options/Size"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
item_count = 2
selected = 0
popup/item_0/text = "Native size"
popup/item_0/id = 0
popup/item_1/text = "Current zoom"
popup/item_1/id = 1
tooltip_text = "Exports the complete map. Current zoom uses the displayed tile size."

[node name="Quality" type="HBoxContainer" parent="Options"]
layout_mode = 2

[node name="Label" type="Label" parent="Options/Quality"]
layout_mode = 2
custom_minimum_size = Vector2(95, 0)
