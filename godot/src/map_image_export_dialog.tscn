[node name="ExportOverlays" type="CheckBox" parent="Options"]
unique_name_in_owner = true
layout_mode = 2
text = "Include active overlays"
button_pressed = true
tooltip_text = "Includes enabled map overlays. Terrain, special artwork and dungeon features are always included. Unapplied painting and selection outlines are excluded."

[node name="ExportStatus" type="Label" parent="Options"]
