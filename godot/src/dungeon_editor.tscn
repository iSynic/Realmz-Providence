[node name="DungeonEditor" type="VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
script = ExtResource("1")

[node name="WorldSections" parent="." instance=ExtResource("9")]
unique_name_in_owner = true

[node name="DungeonHeader" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="DungeonMapTitle" type="Label" parent="DungeonHeader"]
unique_name_in_owner = true
layout_mode = 2
theme = ExtResource("8")
size_flags_horizontal = 3
theme_type_variation = &"WorldTitle"
text = "DUNGEON 00  ·  NO MAP OPEN  ·  90 × 90"

[node name="ZoomOut" type="Button" parent="DungeonHeader"]
layout_mode = 2
text = "−"

[node name="ZoomIn" type="Button" parent="DungeonHeader"]
layout_mode = 2
text = "+"

[node name="ZoomFit" type="Button" parent="DungeonHeader"]
layout_mode = 2
text = "Fit"

[node name="ExportMapImage" type="Button" parent="DungeonHeader"]
unique_name_in_owner = true
layout_mode = 2
text = "Export JPEG…"
disabled = true

[node name="DungeonWorkbench" type="HSplitContainer" parent="."]
layout_mode = 2
