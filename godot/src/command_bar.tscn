[gd_scene load_steps=6 format=3]

[ext_resource path="res://src/command_bar.gd" type="Script" id="1"]
[ext_resource path="res://src/application_menu.tscn" type="PackedScene" id="2_application_menu"]

[ext_resource path="res://theme/shell_header_theme.tres" type="Theme" id="3_header"]
[ext_resource path="res://branding/manual-red-dragon.png" type="Texture2D" id="4_dragon"]

[sub_resource type="StyleBoxFlat" id="RailCap"]
bg_color = Color(0.071, 0.086, 0.106, 1)
border_width_right = 1
border_color = Color(0.153, 0.192, 0.235, 1)

[node name="CommandBar" type="HBoxContainer"]
custom_minimum_size = Vector2(0, 52)
theme_override_constants/separation = 8
theme = ExtResource("3_header")
script = ExtResource("1")

[node name="RailCap" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(92, 52)
layout_mode = 2
theme_override_styles/panel = SubResource("RailCap")

[node name="ProvidenceMark" type="Button" parent="RailCap"]
layout_mode = 2
tooltip_text = "Divinity Manual"
flat = true
icon = ExtResource("4_dragon")
icon_alignment = 1
expand_icon = true
theme_override_constants/icon_max_width = 48
texture_filter = 1

[node name="ProvidenceBrand" type="VBoxContainer" parent="."]
custom_minimum_size = Vector2(170, 0)
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 0

[node name="ApplicationName" type="Label" parent="ProvidenceBrand"]
layout_mode = 2
theme_override_colors/font_color = Color(0.929412, 0.956863, 0.984314, 1)
theme_override_font_sizes/font_size = 15
text = "Realmz Providence"

[node name="ProjectName" type="Label" parent="ProvidenceBrand"]
layout_mode = 2
theme_override_colors/font_color = Color(0.619608, 0.694118, 0.760784, 1)
theme_override_font_sizes/font_size = 11
text = "No project open"
clip_text = true
text_overrun_behavior = 3

[node name="ApplicationMenu" parent="." instance=ExtResource("2_application_menu")]

[node name="Back" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(36, 34)
size_flags_vertical = 4
disabled = true
tooltip_text = "Back · Alt+Left"
text = "←"

[node name="Forward" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(36, 34)
size_flags_vertical = 4
disabled = true
tooltip_text = "Forward · Alt+Right"
text = "→"

[node name="CommandTitle" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(100, 0)
size_flags_horizontal = 3
clip_text = true
text_overrun_behavior = 3
theme_override_colors/font_color = Color(0.619608, 0.694118, 0.760784, 1)
theme_override_font_sizes/font_size = 11
text = "STORY  /  STRING EDITOR"

[node name="Search" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(86, 34)
size_flags_vertical = 4
disabled = true
tooltip_text = "Search Scenario · Ctrl+Shift+F"
text = "Search"

[node name="Undo" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(36, 34)
size_flags_vertical = 4
text = "Undo"

[node name="Redo" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(36, 34)
size_flags_vertical = 4
text = "Redo"

[node name="Validate" type="Button" parent="."]
layout_mode = 2
custom_minimum_size = Vector2(36, 34)
size_flags_vertical = 4
text = "Validate"

[node name="CommitEdit" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(36, 34)
size_flags_vertical = 4
text = "Commit Edit"

[node name="Save" type="Button" parent="."]
layout_mode = 2
custom_minimum_size = Vector2(36, 34)
size_flags_vertical = 4
text = "Save"

[node name="Compile" type="Button" parent="."]
layout_mode = 2
custom_minimum_size = Vector2(36, 34)
size_flags_vertical = 4
text = "Publish"
tooltip_text = "Choose a format and destination for export."

[node name="Commands" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(36, 34)
size_flags_vertical = 4
text = "Commands"

[connection signal="pressed" from="Undo" to="." method="emit_signal" binds=["undo_requested"]]
[connection signal="pressed" from="Redo" to="." method="emit_signal" binds=["redo_requested"]]
[connection signal="pressed" from="Back" to="." method="emit_signal" binds=["back_requested"]]
[connection signal="pressed" from="Forward" to="." method="emit_signal" binds=["forward_requested"]]
[connection signal="pressed" from="Validate" to="." method="emit_signal" binds=["validate_requested"]]
[connection signal="pressed" from="CommitEdit" to="." method="emit_signal" binds=["commit_requested"]]
[connection signal="pressed" from="Save" to="." method="emit_signal" binds=["save_requested"]]
[connection signal="pressed" from="Compile" to="." method="emit_signal" binds=["compile_requested"]]
[connection signal="pressed" from="Commands" to="." method="emit_signal" binds=["commands_requested"]]

[connection signal="pressed" from="Search" to="." method="emit_signal" binds=["search_requested"]]
