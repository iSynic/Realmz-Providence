[gd_scene format=3]

[node name="Item" type="Button"]
custom_minimum_size = Vector2(0, 56)
size_flags_horizontal = 3
toggle_mode = true
theme_type_variation = &"ItemRow"

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
theme_override_constants/margin_left = 6
theme_override_constants/margin_right = 6
theme_override_constants/margin_top = 6
theme_override_constants/margin_bottom = 6

[node name="Body" type="HBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Thumbnail" type="PanelContainer" parent="Margin/Body"]
layout_mode = 2
custom_minimum_size = Vector2(40, 40)
size_flags_vertical = 4
mouse_filter = 2
theme_type_variation = &"ItemThumbnail"

[node name="Picture" type="TextureRect" parent="Margin/Body/Thumbnail"]
layout_mode = 2
mouse_filter = 2
texture_filter = 1
expand_mode = 1
stretch_mode = 5

[node name="Placeholder" type="Label" parent="Margin/Body/Thumbnail"]
layout_mode = 2
mouse_filter = 2
text = "—"
horizontal_alignment = 1
vertical_alignment = 1
theme_type_variation = &"ItemContext"

[node name="Labels" type="VBoxContainer" parent="Margin/Body"]
layout_mode = 2
mouse_filter = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_constants/separation = 4

[node name="Name" type="Label" parent="Margin/Body/Labels"]
layout_mode = 2
mouse_filter = 2
text_overrun_behavior = 3
clip_text = true
theme_type_variation = &"ItemName"

[node name="Context" type="Label" parent="Margin/Body/Labels"]
layout_mode = 2
mouse_filter = 2
text_overrun_behavior = 3
clip_text = true
theme_type_variation = &"ItemContext"

[node name="Id" type="PanelContainer" parent="Margin/Body"]
layout_mode = 2
custom_minimum_size = Vector2(38, 28)
size_flags_vertical = 4
mouse_filter = 2
theme_type_variation = &"ItemThumbnail"

[node name="Value" type="Label" parent="Margin/Body/Id"]
layout_mode = 2
mouse_filter = 2
horizontal_alignment = 1
theme_type_variation = &"ItemId"
