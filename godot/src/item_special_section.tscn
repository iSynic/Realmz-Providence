[gd_scene format=3]

[node name="Special" type="VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Primary" type="PanelContainer" parent="."]
layout_mode = 2
theme_type_variation = &"ItemSpecialPanel"

[node name="Body" type="VBoxContainer" parent="Primary"]
tooltip_text = "Signed effect codes and unlabelled imported values remain editable."
layout_mode = 2
theme_override_constants/separation = 8

[node name="Heading" type="Label" parent="Primary/Body"]
layout_mode = 2
text = "PRIMARY EFFECT"
theme_type_variation = &"ItemSpecialHeading"

[node name="PrimaryGrid" type="GridContainer" parent="Primary/Body"]
layout_mode = 2
columns = 2
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 8

[node name="Special1Field" type="VBoxContainer" parent="Primary/Body/PrimaryGrid"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Label" type="Label" parent="Primary/Body/PrimaryGrid/Special1Field"]
layout_mode = 2
text = "SPECIAL 1 · EXACT EFFECT"
theme_type_variation = &"ItemFieldLabel"

[node name="ValueRow" type="HBoxContainer" parent="Primary/Body/PrimaryGrid/Special1Field"]
layout_mode = 2

[node name="Special1" type="SpinBox" parent="Primary/Body/PrimaryGrid/Special1Field/ValueRow"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(100, 32)
min_value = -32768.0
max_value = 32767.0
allow_greater = true
allow_lesser = true
metadata/field_name = "special.0"

[node name="ChooseSpecial1" type="Button" parent="Primary/Body/PrimaryGrid/Special1Field/ValueRow"]
layout_mode = 2
text = "Choose…"
custom_minimum_size = Vector2(0, 32)

[node name="Special2Field" type="VBoxContainer" parent="Primary/Body/PrimaryGrid"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Label" type="Label" parent="Primary/Body/PrimaryGrid/Special2Field"]
layout_mode = 2
text = "SPELL / AMOUNT · SPECIAL 2"
theme_type_variation = &"ItemFieldLabel"

[node name="ValueRow" type="HBoxContainer" parent="Primary/Body/PrimaryGrid/Special2Field"]
layout_mode = 2

[node name="Special2" type="SpinBox" parent="Primary/Body/PrimaryGrid/Special2Field/ValueRow"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(100, 32)
min_value = -32768.0
max_value = 32767.0
allow_greater = true
allow_lesser = true
metadata/field_name = "special.1"

[node name="ChooseSpecial2" type="Button" parent="Primary/Body/PrimaryGrid/Special2Field/ValueRow"]
layout_mode = 2
text = "Choose…"
custom_minimum_size = Vector2(0, 32)

[node name="PrimaryHint" type="Label" parent="Primary/Body"]
visible = false
layout_mode = 2
text = "Named effects retain their signed code. Unknown values remain editable."
theme_type_variation = &"ItemContext"

autowrap_mode = 2

