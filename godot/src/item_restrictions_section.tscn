theme_type_variation = &"ItemFieldLabel"

[node name="Row" type="HBoxContainer" parent="Specific/Body/References/SpecificRaceField"]
layout_mode = 2

[node name="SpecificRace" type="LineEdit" parent="Specific/Body/References/SpecificRaceField/Row"]
layout_mode = 2
size_flags_horizontal = 3
editable = false
placeholder_text = "None"

[node name="ChooseSpecificRace" type="Button" parent="Specific/Body/References/SpecificRaceField/Row"]
layout_mode = 2
text = "Choose…"
custom_minimum_size = Vector2(0, 32)

[node name="SpecificCasteField" type="VBoxContainer" parent="Specific/Body/References"]
layout_mode = 2
