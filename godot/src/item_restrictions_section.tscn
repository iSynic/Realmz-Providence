[gd_scene format=3]

[node name="Restrictions" type="VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Classification" type="PanelContainer" parent="."]
layout_mode = 2
theme_type_variation = &"ItemRestrictionsPanel"

[node name="Body" type="VBoxContainer" parent="Classification"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Heading" type="Label" parent="Classification/Body"]
layout_mode = 2
text = "CLASSIFICATION"
theme_type_variation = &"ItemRestrictionsHeading"

[node name="CategoryRow" type="HBoxContainer" parent="Classification/Body"]
layout_mode = 2

[node name="CategorySummary" type="Label" parent="Classification/Body/CategoryRow"]
layout_mode = 2
text = "No categories"

[node name="ChooseCategories" type="Button" parent="Classification/Body/CategoryRow"]
layout_mode = 2
text = "Choose…"
custom_minimum_size = Vector2(0, 32)

[node name="Specific" type="PanelContainer" parent="."]
layout_mode = 2
theme_type_variation = &"ItemRestrictionsPanel"

[node name="Body" type="VBoxContainer" parent="Specific"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Heading" type="Label" parent="Specific/Body"]
layout_mode = 2
text = "SPECIFIC RACE AND CASTE"
theme_type_variation = &"ItemRestrictionsHeading"

[node name="References" type="GridContainer" parent="Specific/Body"]
layout_mode = 2
columns = 2
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 8

[node name="SpecificRaceField" type="VBoxContainer" parent="Specific/Body/References"]
layout_mode = 2
