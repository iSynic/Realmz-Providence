[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/issues_filter_bar.gd" id="1"]

[node name="FilterBar" type="VBoxContainer"]
layout_mode = 2
script = ExtResource("1")

[node name="Types" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="TypeFilter" type="OptionButton" parent="Types"]
layout_mode = 2
size_flags_horizontal = 3
fit_to_longest_item = false
tooltip_text = "Filter by diagnostic type."

[node name="PageSize" type="OptionButton" parent="Types"]
layout_mode = 2
tooltip_text = "Findings per page. Scroll within the list to see every row."

[node name="Uncalled" type="CheckButton" parent="."]
layout_mode = 2
text = "Hide warnings with no known callers"
tooltip_text = "All record types, using Find Uses. Automatic triggers can run without callers; this is not proof of no gameplay effect. Errors and unknown caller status remain visible. View only; export checks are unchanged."

[node name="Temporary" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Enabled" type="CheckButton" parent="Temporary"]
layout_mode = 2
text = "Apply hidden filters"
tooltip_text = "Temporary view filters only. Export checks still include hidden findings. Filters reset when the project changes."

[node name="Rules" type="MenuButton" parent="Temporary"]
layout_mode = 2
text = "Hidden filters (0)"
tooltip_text = "Toggle individual filters or remove them."

[node name="Count" type="Label" parent="Temporary"]
layout_mode = 2
