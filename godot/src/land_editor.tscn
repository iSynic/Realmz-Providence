[node name="MapImageExport" parent="." instance=ExtResource("9")]
unique_name_in_owner = true

[connection signal="pressed" from="MapToolbar/ZoomOut" to="." method="_on_zoom_out_pressed"]
[connection signal="pressed" from="MapToolbar/ZoomIn" to="." method="_on_zoom_in_pressed"]
[connection signal="pressed" from="MapToolbar/ZoomFit" to="." method="_on_zoom_fit_pressed"]
[connection signal="cell_selected" from="LandMapCanvas" to="." method="_on_canvas_cell_selected"]
[connection signal="action_point_activated" from="LandMapCanvas" to="." method="_on_canvas_action_point_activated"]
[connection signal="zoom_changed" from="LandMapCanvas" to="." method="_on_canvas_zoom_changed"]
