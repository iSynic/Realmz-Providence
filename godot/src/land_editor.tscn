[gd_scene load_steps=10 format=3]

[ext_resource path="res://src/land_editor.gd" type="Script" id="1"]
[ext_resource path="res://src/map_canvas.gd" type="Script" id="2"]
[ext_resource path="res://src/map_editor_preview.tscn" type="PackedScene" id="3"]
[ext_resource path="res://src/random_region_overlay.tscn" type="PackedScene" id="4"]
[ext_resource path="res://src/land_area_overlay.tscn" type="PackedScene" id="5"]
[ext_resource path="res://src/world_controls.tres" type="Theme" id="6"]
[ext_resource path="res://src/map_view_filters.tscn" type="PackedScene" id="7"]
[ext_resource path="res://src/map_view_overlay.gd" type="Script" id="8"]
[ext_resource path="res://src/map_image_export_dialog.tscn" type="PackedScene" id="9"]

[node name="LandEditor" type="VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
script = ExtResource("1")

[node name="MapSectionTabs" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 5

[node name="CanvasSection" type="Button" parent="MapSectionTabs"]
layout_mode = 2
toggle_mode = true
button_pressed = true
text = "Canvas"

[node name="LandLayoutSection" type="Button" parent="MapSectionTabs"]
layout_mode = 2
tooltip_text = "Compose the world layout and inspect neighboring maps."
text = "Land Layout"

[node name="LandTilesSection" type="Button" parent="MapSectionTabs"]
layout_mode = 2
tooltip_text = "Browse exact Scenario and Stock Special Tiles for this map."
text = "Special Tiles"

[node name="RandomEncountersSection" type="Button" parent="MapSectionTabs"]
layout_mode = 2
tooltip_text = "Edit spatial encounter regions on this map."
text = "Random Areas"

[node name="MapToolbar" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="MapTitle" type="Label" parent="MapToolbar"]
unique_name_in_owner = true
layout_mode = 2
theme = ExtResource("6")
size_flags_horizontal = 3
theme_type_variation = &"WorldTitle"
clip_text = true
text = "LAND 0  ·  THORNWATCH COAST  ·  90 × 90"

[node name="ZoomOut" type="Button" parent="MapToolbar"]
layout_mode = 2
tooltip_text = "Zoom out"
text = "−"

[node name="MapZoom" type="Label" parent="MapToolbar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(48, 0)
layout_mode = 2
text = "100%"
tooltip_text = "100% fits the complete map. The initial editing view uses readable 16 px cells."
horizontal_alignment = 1

[node name="ZoomIn" type="Button" parent="MapToolbar"]
layout_mode = 2
tooltip_text = "Zoom in"
text = "+"

[node name="ZoomFit" type="Button" parent="MapToolbar"]
layout_mode = 2
tooltip_text = "Fit the complete 90 × 90 map"
text = "Fit"

[node name="ExportMapImage" type="Button" parent="MapToolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "Export JPEG…"
disabled = true

[node name="PaintTools" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Brush" type="Button" parent="PaintTools"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
toggle_mode = true
text = "Brush  B"

[node name="Select" type="Button" parent="PaintTools"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
toggle_mode = true
text = "Select  M"

[node name="Fill" type="Button" parent="PaintTools"]
layout_mode = 2
tooltip_text = "Choose shape and painting options; review affected cells before Apply."
theme_override_font_sizes/font_size = 12
toggle_mode = true
disabled = true
text = "Fill  G"

[node name="Sample" type="Button" parent="PaintTools"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
toggle_mode = true
text = "Sample  I"

[node name="Stamp" type="Button" parent="PaintTools"]
layout_mode = 2
tooltip_text = "Choose a saved stamp, then review its destination before Apply."
theme_override_font_sizes/font_size = 12
toggle_mode = true
disabled = true
text = "Stamp  S"

[node name="Erase" type="Button" parent="PaintTools"]
layout_mode = 2
tooltip_text = "Choose shape and painting options; review affected cells before Apply."
theme_override_font_sizes/font_size = 12
toggle_mode = true
disabled = true
text = "Erase  E"

[node name="Pan" type="Button" parent="PaintTools"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
toggle_mode = true
text = "Pan  H"

[node name="Shapes" type="Button" parent="PaintTools"]
layout_mode = 2
tooltip_text = "Choose shape and painting options; review affected cells before Apply."
theme_override_font_sizes/font_size = 12
toggle_mode = true
disabled = true
text = "Shapes ▾"

[node name="SmartTerrain" type="Button" parent="PaintTools"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "Smart terrain…"

[node name="MapViewFilters" parent="." instance=ExtResource("7")]
unique_name_in_owner = true
layout_mode = 2

[node name="LandMapCanvas" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
script = ExtResource("2")

[node name="MapEditorPreview" parent="LandMapCanvas" instance=ExtResource("3")]
unique_name_in_owner = true

[node name="MapViewOverlay" type="Control" parent="LandMapCanvas"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("8")

[node name="RandomRegionOverlay" parent="LandMapCanvas" instance=ExtResource("4")]
unique_name_in_owner = true

[node name="LandAreaOverlay" parent="LandMapCanvas" instance=ExtResource("5")]
unique_name_in_owner = true

[node name="MagicOverlay" parent="LandMapCanvas" instance=ExtResource("5")]
unique_name_in_owner = true

[node name="EmptyLandHint" type="Label" parent="."]
visible = false
text = "Create a Land map with New Land, or open an existing map."
theme_override_colors/font_color = Color(0.97, 0.76, 0.36, 1)

[node name="PaintSelectionContext" type="HFlowContainer" parent="."]
layout_mode = 2

[node name="Summary" type="Label" parent="PaintSelectionContext"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 12
clip_text = true
text = "Paint artwork · Action Point records retained"

[node name="SelectionActions" type="Button" parent="PaintSelectionContext"]
unique_name_in_owner = true
disabled = true
text = "Selection actions…"

[node name="FillSelection" type="Button" parent="PaintSelectionContext"]
unique_name_in_owner = true
layout_mode = 2
disabled = true
text = "Fill"

[node name="ClearSelection" type="Button" parent="PaintSelectionContext"]
unique_name_in_owner = true
layout_mode = 2
disabled = true
text = "Clear"

[node name="ReplaceSelection" type="Button" parent="PaintSelectionContext"]
unique_name_in_owner = true
layout_mode = 2
disabled = true
text = "Replace"

[node name="ClearAreaSelection" type="Button" parent="PaintSelectionContext"]
unique_name_in_owner = true
layout_mode = 2
disabled = true
text = "Deselect"

[node name="ReconcileArea" type="Button" parent="PaintSelectionContext"]
unique_name_in_owner = true
visible = false
layout_mode = 2
text = "Check original operation"

[node name="CellDetails" type="Button" parent="PaintSelectionContext"]
layout_mode = 2
text = "Cell details…"

[node name="CellScript" type="Button" parent="PaintSelectionContext"]
layout_mode = 2
disabled = true
