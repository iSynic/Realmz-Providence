; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Providence vNext"
config/version="0.6.0-beta.1"
run/main_scene="res://src/startup_splash.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/use_filter=false
boot_splash/image="res://branding/startup-splash.png"
config/icon="res://branding/application-icon.png"
config/macos_native_icon="res://branding/application-icon.icns"
config/windows_native_icon="res://branding/application-icon.ico"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900
window/size/min_width=1200
window/size/min_height=720

[gui]

theme/custom="res://theme/providence_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.047, 0.058, 0.071, 1)
textures/vram_compression/import_etc2_astc=true
